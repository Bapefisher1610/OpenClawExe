<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.AIProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="16" MaxWidth="840">
            <TextBlock Text="AI Provider" Style="{StaticResource TitleTextBlockStyle}"/>

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"/>

            <InfoBar x:Name="ConnectionInfoBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Local gateway not detected"
                     Message="This page can update provider keys for a local WSL gateway. Connect to a local gateway or run setup first.">
                <InfoBar.ActionButton>
                    <Button Content="Open Connection" Click="OnOpenConnection"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="ProviderCombo"
                                  Header="Provider"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="OpenAI" Tag="OPENAI_API_KEY"/>
                            <ComboBoxItem Content="OpenRouter" Tag="OPENROUTER_API_KEY"/>
                            <ComboBoxItem Content="Anthropic" Tag="ANTHROPIC_API_KEY"/>
                            <ComboBoxItem Content="Google Gemini" Tag="GOOGLE_API_KEY"/>
                        </ComboBox>

                        <TextBox x:Name="AgentIdBox"
                                 Grid.Column="1"
                                 Header="Agent"
                                 Text="main"/>

                        <ComboBox x:Name="ModelCombo"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Header="Model"
                                  SelectedIndex="0"/>
                    </Grid>

                    <PasswordBox x:Name="ApiKeyBox"
                                 Header="API key"
                                 PlaceholderText="Paste a new provider API key"/>

                    <StackPanel x:Name="OpenAICodexOAuthPanel" Spacing="8">
                        <Button x:Name="OpenAICodexOAuthButton"
                                Content="Login with OpenAI Codex OAuth"
                                Click="OnOpenAICodexOAuthLogin"/>
                        <HyperlinkButton x:Name="OpenAICodexOAuthLink"
                                         Content="Open generated OAuth link"
                                         Visibility="Collapsed"
                                         Padding="0"/>
                        <TextBlock x:Name="OpenAICodexOAuthStatusText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="ProviderPathText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton"
                                Content="Save &amp; Restart Gateway"
                                Click="OnSave"/>
                        <Button Content="Refresh Status"
                                Click="OnRefreshStatus"/>
                        <Button Content="Open Usage"
                                Click="OnOpenUsage"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="OpenAI OAuth profiles" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ComboBox x:Name="OAuthProfileCombo"
                              Header="Active OpenAI account"
                              PlaceholderText="No OAuth profiles found"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Use selected account"
                                Click="OnUseSelectedOAuthProfile"/>
                        <Button Content="Refresh"
                                Click="OnRefreshStatus"/>
                    </StackPanel>
                    <TextBlock x:Name="OAuthProfileStatusText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Provider status" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="ProviderStatusText"
                               Text="Status has not been checked yet."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
